{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/layout/AppSidebar.jsx", "src/components/ecommerce/RecentOrders.jsx", "src/components/auth/SignUpForm.jsx", "src/components/auth/SignInForm.jsx", "src/components/ecommerce/OverviewCard.jsx", "src/components/ecommerce/StatisticsChart.jsx", "src/components/header/UserDropdown.jsx", "src/app/layout.tsx", "src/app/(admin)/layout.jsx", "src/feature/UserApi.js", "src/app/(admin)/(others-pages)/profile/page.jsx", "src/secureRoute/SecureProvider.jsx", "src/app/(admin)/(others-pages)/users/page.jsx", "src/secureRoute/SecureAdminRoute.tsx"],
  "exclude": ["node_modules"]
}
